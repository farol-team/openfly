# Source explicitly after replacing values. Never commit real .env files.
DATABASE_URL=postgresql:///execution_pool_development
# Generate each independently: ruby -rsecurerandom -e 'puts SecureRandom.hex(64)'
SECRET_KEY_BASE=
POOL_TOKEN_PEPPER=
POOL_HOST=localhost
POOL_STORAGE_ROOT=/var/lib/openfly
POOL_SECRET_ROOT=/dev/shm/openfly-secrets
POOL_PYTHON=python3
# Docker is development-only and disabled by default.
POOL_ALLOW_DOCKER_TEST=0
