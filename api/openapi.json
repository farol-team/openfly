  "components": {
    "securitySchemes": {
      "ServiceToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Per-application credential; tenant and scopes resolved server-side. Never supplied to guest."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "request_id"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "CreateArtifact": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "workspace_input",
              "operation_request"
            ]
          },
          "media_type": {
            "type": "string",
            "enum": [
              "application/gzip",
              "application/json"
            ]
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 268435456
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "kind",
          "media_type",
          "size_bytes",
          "sha256"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "operation_request"
                }
              }
            },
            "then": {
              "properties": {
                "media_type": {
                  "const": "application/json"
                },
                "size_bytes": {
                  "maximum": 1048576
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "workspace_input"
                }
              }
            },
            "then": {
              "properties": {
                "media_type": {
                  "const": "application/gzip"
                }
              }
            }
          }
        ]
      },
      "Artifact": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_.-]+$"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "validating",
              "ready",
              "rejected",
              "expired"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "workspace_input",
              "operation_request",
              "checkpoint",
              "result",
              "log",
              "recovery"
            ]
          },
          "media_type": {
            "type": "string"
          },
          "size_bytes": {
